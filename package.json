{
  "name": "code-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 2D/3D-ready map of software architecture and source structure",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "serve": "npm run build && NODE_ENV=production npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@binclusive/tree-sitter-kotlin-wasm": "0.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xyflow/react": "^12.11.3",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "web-tree-sitter": "^0.26.13"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
